<turbo-frame id="modal">
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
        data-controller="modal"
        data-action="click->modal#backdrop"
    >
        <div class="bg-white dark:bg-zinc-700 rounded-xl p-6 w-full max-w-lg relative">
            <h2 class="text-xl font-bold mb-1">Time Attendance</h2>
            <p class="text-gray-500 dark:text-gray-300 mb-4">
            <%= Time.current.strftime("%d %b %Y %H:%M") %>
            </p>

            <%= form_with model: @attendance, data: { turbo_frame: "_top", controller: "attendance-validation" } do |f| %>

                <div class="mb-4">
                    <label class="text-sm">Check in</label>
                    <%= f.time_field :check_in,
                        step: 60,
                        value: @attendance.check_in.strftime("%H:%M"),
                        data: { attendance_validation_target: "checkin", action: "input->attendance-validation#validate" },
                        class: "block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full border-slate-300 dark:border-zinc-500 focus:outline-none" %>
                </div>

                <div class="mb-2">
                    <label class="text-sm">Check out</label>
                    <%= f.time_field :check_out,
                        step: 60,
                        value: (@attendance.check_out || Time.current).strftime("%H:%M"),
                        data: { attendance_validation_target: "checkout", action: "input->attendance-validation#validate" },
                        class: "block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full border-slate-300 dark:border-zinc-500 focus:outline-none" %>
                </div>

                <p class="text-red-400 text-sm mb-4 hidden"
                    data-attendance-validation-target="error">
                    Check out must be after check in
                </p>

                <%= f.button type: "submit",
                    data: { attendance_validation_target: "submit" },
                    class: "w-full sm:w-auto flex items-center mt-6 gap-2 rounded-lg px-3.5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed" do %>
                    <%= heroicon "check", variant: :solid, options: { class: "w-4 h-4" } %>
                    <span>Save Attendance</span>
                <% end %>

            <% end %>
        </div>
    </div>
</turbo-frame>