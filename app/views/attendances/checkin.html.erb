<turbo-frame id="modal">
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
        data-controller="modal"
        data-action="click->modal#backdrop"
    >
        <div class="bg-white dark:bg-zinc-700 rounded-xl p-6 w-full max-w-lg relative">
            <h2 class="text-xl font-bold mb-1">Check in</h2>
            <p class="text-gray-500 dark:text-gray-300 mb-4">
                <%= Time.current.strftime("%d %b %Y %H:%M") %>
            </p>

            <%= form_with model: @attendance, data: { turbo_frame: "_top" } do |f| %>
                <%= f.hidden_field :employee_id %>
                <%= f.hidden_field :work_date %>

                <div class="mb-8">
                    <%= f.time_field :check_in,
                        step: 60,
                        value: (@attendance.check_in || Time.current).strftime("%H:%M"),
                        class: "block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full border-slate-300 dark:border-zinc-500 focus:outline-none" 
                    %>
                </div>

                <%= f.button type: "submit", class: "w-full sm:w-auto flex items-center gap-2 rounded-lg px-3.5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium transition-all" do %>
                    <%= heroicon "check", variant: :solid, options: { class: "w-4 h-4" } %>
                    <span>Check in</span>
                <% end %>
            <% end %>
        </div>
    </div>
</turbo-frame>