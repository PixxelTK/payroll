<% content_for :title, "Employees" %>

<%= render "shared/page_header",
    title: "Employees Management",
    breadcrumb: nil
%>

<div class="w-[90%] max-w-4xl flex flex-col sm:flex-row mx-auto bg-white dark:bg-zinc-700 shadow-lg dark:shadow-xl rounded-2xl -mt-12 p-4 relative z-10 sm:justify-between sm:items-center gap-2">
    <%= form_with url: employees_path,
        method: :get,
        data: { turbo_frame: "employees" },
        class: "relative flex-1" do |f| 
    %>
        <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                <%= heroicon "magnifying-glass", variant: :solid, options: { class: "w-6 h-6" } %>
            </span>

            <%= f.text_field :q,
                value: params[:q],
                placeholder: "Search employee...",
                class: "w-full pl-12 py-2 rounded-lg text-lg focus:outline-none transition"
            %>
        </div>
    <% end %>

    <%= link_to new_employee_path, class: "w-full sm:w-auto flex items-center gap-2 rounded-lg px-3.5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium transition-all" do %>
        <%= heroicon "plus", variant: :solid, options: { class: "w-5 h-5" } %>
        New employee
    <% end %>
</div>

<div class="w-[90%] max-w-4xl mx-auto mt-6">
    <% if notice.present? %>
        <p class="text-green-500 font-medium inline-block py-1" id="notice"><%= notice %></p>
    <% end %>

    <turbo-frame id="employees">
        <%= render "employees", employees: @employees %>
    </turbo-frame>
</div>