<% content_for :title, "Employees" %>

<%= render "shared/page_header",
    title: "Employees Management",
    breadcrumb: nil
%>

<div class="w-[90%] flex flex-col sm:flex-row mx-auto bg-white dark:bg-zinc-700 shadow-lg dark:shadow-xl rounded-2xl -mt-12 p-4 relative z-10 sm:justify-between sm:items-center gap-2">
    <h2 class="pl-2 text-lg font-medium">
        <%= pluralize(@employees.count, "Employee") %>
    </h2>
    <%= link_to "New employee", new_employee_path, class: "w-full sm:w-auto rounded-lg px-3.5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white inline-block font-medium cursor-pointer transition-all" %>
</div>

<div class="w-[90%] mx-auto mt-6">
    <% if notice.present? %>
        <p class="py-2 px-3 bg-green-50/50 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    <% end %>

    <div id="employees" class="mt-4 bg-white dark:bg-zinc-800 rounded-xl shadow overflow-hidden">
        <div class="grid grid-cols-3 gap-4 px-4 py-3 bg-white dark:bg-zinc-700/50 font-semibold text-slate-600 dark:text-slate-200">
            <div>Name</div>
            <div>Position</div>
            <div class="text-right">Actions</div>
        </div>

        <% if @employees.any? %>
            <% @employees.each_with_index do |employee, index| %>

                <div class="grid grid-cols-3 gap-4 px-4 py-3 items-center border-t border-gray-200 dark:border-zinc-800/50
                    <%= index.even? ?
                        'bg-slate-100/80 dark:bg-zinc-700/90 ' :
                        'bg-slate-100/50 dark:bg-zinc-700/80' 
                    %>
                    hover:bg-slate-100 dark:hover:bg-zinc-700 transition">

                    <div class="font-medium text-slate-800 dark:text-white">
                        <%= employee.name %>
                    </div>

                    <div class="text-slate-600 dark:text-slate-300">
                        <%= employee.position %>
                    </div>

                    <div class="flex justify-end gap-2">
                        <%= link_to "Show", employee, class: "w-full px-4 py-1 rounded-full sm:w-auto text-center bg-sky-500 text-white inline-block" %>
                        <%= link_to "Edit", edit_employee_path(employee), class: "w-full px-4 py-1 rounded-full sm:w-auto text-center bg-blue-500 text-white inline-block" %>
                    </div>
                </div>
            <% end %>
        <% else %>
            <div class="text-center bg-white dark:bg-zinc-700 py-10 text-slate-400">
                No employees found.
            </div>
        <% end %>
    </div>
</div>