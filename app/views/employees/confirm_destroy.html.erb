<turbo-frame id="modal">

  <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
       data-controller="modal"
       data-action="click->modal#backdrop">

    <div class="bg-white dark:bg-zinc-700 rounded-xl p-6 w-full max-w-md relative">

      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-bold text-red-400">Delete Employee</h2>

        <button
          class="text-gray-500 dark:text-gray-200 cursor-pointer"
          data-action="click->modal#close">
          <%= heroicon "x-mark", variant: :solid, options: { class: "w-6 h-6" } %>
        </button>
      </div>

      <p class="mb-6 text-gray-600 dark:text-gray-200">
        Are you sure you want to delete
        <span class="font-semibold"><%= @employee.name %></span> ?
      </p>

      <div class="flex justify-end gap-2">

        <%= button_to "Delete",
          employee_path(@employee),
          method: :delete,
          form: { data: { turbo_frame: "_top" } },
          class: "px-4 py-2 rounded-md bg-red-500 text-white hover:bg-red-400 transition cursor-pointer" %>

        <button
          class="px-4 py-2 rounded-md bg-gray-100 dark:bg-zinc-500 hover:bg-gray-200 dark:hover:bg-zinc-500/90 transition cursor-pointer"
          data-action="click->modal#close">
          Cancel
        </button>

      </div>

    </div>
  </div>

</turbo-frame>