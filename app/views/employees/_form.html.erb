<%= form_with(model: employee, data: { turbo_frame: "_top" }, class: "contents") do |form| %>

  <% if employee.errors.any? %>
    <div class="bg-red-50/80 text-red-500 mb-2 px-3 py-2 font-medium rounded-md">
      <h2><%= pluralize(employee.errors.count, "error") %> prohibited this employee from being saved</h2>

      <ul class="list-disc ml-6">
        <% employee.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <div>
    <%= form.label :name %>
    <%= form.text_field :name,
      class: ["block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full",
      {"border-slate-300 dark:border-zinc-500 focus:outline-none": employee.errors[:name].none?,
       "border-red-400 focus:outline-red-600": employee.errors[:name].any?}] %>
  </div>


  <div class="my-5">
    <%= form.label :position %>
    <%= form.select :position,
      Employee::POSITIONS,
      { prompt: "Select position" },
      class: ["block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full",
      {"border-slate-300 dark:border-zinc-500 focus:outline-none": employee.errors[:position].none?,
       "border-red-400 focus:outline-red-600": employee.errors[:position].any?}] %>
  </div>


  <div class="my-5">
    <%= form.label :salary %>
    <%= form.text_field :salary,
      class: ["block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full",
      {"border-slate-300 dark:border-zinc-500 focus:outline-none": employee.errors[:salary].none?,
       "border-red-400 focus:outline-red-600": employee.errors[:salary].any?}] %>
  </div>


  <div class="my-5">
    <%= form.label :pin, "PIN" %>
    <%= form.password_field :pin, maxlength: 4,
      class: ["block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full",
      {"border-slate-300 dark:border-zinc-500 focus:outline-none": employee.errors[:pin].none?,
       "border-red-400 focus:outline-red-600": employee.errors[:pin].any?}] %>
  </div>


  <div class="my-5">
    <%= form.label :pin_confirmation, "Confirm PIN" %>
    <%= form.password_field :pin_confirmation, maxlength: 4,
      class: "block bg-gray-50 dark:bg-zinc-600 border rounded-md px-3 py-2 mt-2 w-full border-slate-300 dark:border-zinc-500 focus:outline-none" %>
  </div>


  <div>
    <%= form.submit "Save Employee",
      class: "w-full sm:w-auto rounded-lg px-3.5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium transition-all" %>
  </div>

<% end %>