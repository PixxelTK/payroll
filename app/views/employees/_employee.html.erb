<div id="employees" class="mt-4 bg-white dark:bg-zinc-800 rounded-xl shadow overflow-hidden">
    <div class="grid grid-cols-3 gap-4 px-4 py-3 bg-white dark:bg-zinc-700/50 font-semibold text-slate-600 dark:text-slate-200">
        <div>Name</div>
        <div>Position</div>
        <div class="text-end">Salary</div>
    </div>

    <div class="grid grid-cols-3 gap-4 px-4 py-3 items-center border-t border-gray-200 dark:border-zinc-800/50 bg-slate-100/80 dark:bg-zinc-700/90">
        <div class="font-medium text-slate-800 dark:text-white">
            <%= employee.name %>
        </div>

        <div class="text-slate-600 dark:text-slate-300">
            <%= employee.position %>
        </div>

        <div class="text-slate-600 text-end dark:text-slate-300">
            <%= employee.salary %>
        </div>
    </div>
</div>