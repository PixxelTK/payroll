<div id="employees" class="mt-4 mb-6 bg-white dark:bg-zinc-800 rounded-xl shadow overflow-hidden">
    <div class="grid grid-cols-3 md:grid-cols-4 gap-4 px-4 py-3 bg-white dark:bg-zinc-700/50 font-semibold text-slate-600 dark:text-slate-200">
        <div>Name</div>
        <div>Position</div>
        <div class="text-end">Salary</div>
    </div>

    <div class="grid grid-cols-3 md:grid-cols-4 gap-4 px-4 py-3 items-center border-t border-gray-200 dark:border-zinc-800/50 bg-slate-100/80 dark:bg-zinc-700/90">
        <div class="font-medium text-slate-800 dark:text-white">
            <%= employee.name %>
        </div>

        <div class="text-slate-600 dark:text-slate-300">
            <%= employee.position %>
        </div>

        <div class="text-slate-600 text-end dark:text-slate-300">
            <%= employee.salary %>
        </div>

        <div class="md:grid md:grid-cols-2 flex w-full gap-2 md:pl-6">
            <%= link_to edit_employee_path(@employee),
                data: { turbo_frame: "modal" },
                class: "flex gap-2 items-center rounded-md px-3.5 py-2.5 bg-gray-100 dark:bg-zinc-500 hover:bg-gray-200 dark:hover:bg-zinc-500/90 transition" do %>
                    <%= heroicon "pencil", variant: :solid, options: { class: "w-3 h-3" } %>
                    <span>Edit</span>
            <% end %>

            <%= link_to confirm_destroy_employee_path(@employee),
                data: { turbo_frame: "modal" },
                class: "rounded-md px-3.5 py-2.5 text-white bg-red-500 hover:bg-red-400 font-medium text-center transition" do %>
                    Delete
            <% end %>
        </div>
    </div>
</div>