<div id="<%= dom_id employee %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= employee.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Position:</strong>
    <%= employee.position %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Salary:</strong>
    <%= employee.salary %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Pin digest:</strong>
    <%= employee.pin_digest %>
  </div>
</div>
