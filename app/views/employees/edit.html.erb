<% content_for :title, "Editing employee" %>

<turbo-frame id="modal">

  <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
       data-controller="modal"
       data-action="click->modal#backdrop">

    <div class="bg-white dark:bg-zinc-700 rounded-xl p-6 w-full max-w-lg relative">
      <div class="flex gap-2 items-center justify-between mb-4">
        <h2 class="text-xl font-bold">Edit Employee</h2>

        <button
          class="text-gray-500 dark:text-gray-200 cursor-pointer"
          data-action="click->modal#close">
          <%= heroicon "x-mark", variant: :solid, options: { class: "w-6 h-6" } %>
        </button>
      </div>



      <%= render "form", employee: @employee %>

    </div>
  </div>

</turbo-frame>