<% content_for :title, "Showing employee" %>
<% attendance = @employee.attendances.find_by(work_date: Date.current) %>

<%= render "shared/page_header",
    title: @employee.name,
    breadcrumb: link_to("Employees", employees_path) + " / " + @employee.name
%>

<div class="w-[90%] max-w-4xl mx-auto flex flex-col gap-2 bg-white dark:bg-zinc-700 shadow-lg dark:shadow-xl rounded-2xl -mt-12 p-4 relative z-10 mb-6">
  <div class="flex justify-between gap-2">
    <%= link_to employees_path, class: "w-min flex gap-1 items-center rounded-md px-3.5 py-2.5 bg-gray-100 dark:bg-zinc-500 hover:bg-gray-200 dark:hover:bg-zinc-500/90 transition" do %>
      <%= heroicon "chevron-left", variant: :solid, options: { class: "w-4 h-4" } %>
      <span>Back<span>
    <% end %>

    <% if attendance.nil? %>

      <%= link_to checkin_attendances_path(employee_id: @employee.id),
        data: { turbo_frame: "modal" },
        class: "w-auto flex items-center gap-2 rounded-lg px-3.5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium transition-all" do %>
          <%= heroicon "clock", variant: :solid, options: { class: "w-4 h-4" } %>
          <span>Check in</span>
      <% end %>

    <% elsif attendance.check_out.nil? %>

      <%= link_to checkout_attendance_path(attendance),
        data: { turbo_frame: "modal" },
        class: "w-auto flex items-center gap-2 rounded-lg px-3.5 py-2.5 bg-orange-600 hover:bg-orange-700 text-white font-medium transition-all" do %>
          <%= heroicon "clock", variant: :solid, options: { class: "w-4 h-4" } %>
          <span>Check out</span>
      <% end %>

    <% else %>

      <%= link_to checkout_attendance_path(attendance),
        data: { turbo_frame: "modal" },
        class: "w-auto flex items-center gap-2 rounded-lg px-3.5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium transition-all" do %>
          <%= heroicon "pencil", variant: :solid, options: { class: "w-4 h-4" } %>
          <span>Edit Attendance</span>
      <% end %>

    <% end %>
  </div>
  <% if @employee.attendances.exists?(work_date: Date.current) %>
    <%= render "attendances/today_summary", employee: @employee %>
  <% end %>
</div>

<div class="w-[90%] max-w-4xl mx-auto">
  <% if notice.present? %>
    <p class="text-green-500 font-medium inline-block py-1" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="text-red-500 font-medium inline-block py-1">
      <%= alert %>
    </p>
  <% end %>

  <%= render @employee %>

  <%= render "employees/monthly_payroll_summary", employee: @employee, date: @date %>
</div>

<turbo-frame id="modal"></turbo-frame>